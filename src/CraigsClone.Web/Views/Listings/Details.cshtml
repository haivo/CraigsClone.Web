@model Listing

<article class="listing">
    <h1>@Model.Title</h1>
    <p class="meta">
        <span class="price">@Display.Price(Model.Price)</span>
        · posted @Display.Posted(Model.CreatedAt)
        · <a href="/@Model.City.Slug/@Model.Category.Slug">@Model.Category.Name</a>
        in @Model.City.Name@(string.IsNullOrWhiteSpace(Model.Neighborhood) ? "" : $" / {Model.Neighborhood}")
    </p>

    <div class="description">@Model.Description</div>

    <p class="contact">contact: <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a></p>

    <div class="actions">
        <a href="/listing/@Model.Id/edit">edit</a>
        @* asp-antiforgery is explicit: with a hand-written action attribute the tag helper doesn't add the token on its own. *@
        <form method="post" action="/listing/@Model.Id/delete" asp-antiforgery="true" onsubmit="return confirm('Delete this ad?');">
            <button type="submit">delete</button>
        </form>
    </div>
</article>
