@model ListingFormVm

<div asp-validation-summary="ModelOnly" class="errors"></div>

<p>
    <label asp-for="Title">title</label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="error"></span>
</p>
<p>
    <label asp-for="Description">description</label>
    <textarea asp-for="Description" rows="8"></textarea>
    <span asp-validation-for="Description" class="error"></span>
</p>
<p>
    <label asp-for="Price">price in $ (leave blank if not listed)</label>
    <input asp-for="Price" type="number" step="0.01" min="0" />
    <span asp-validation-for="Price" class="error"></span>
</p>
<p>
    <label asp-for="CityId">city</label>
    <select asp-for="CityId" asp-items="Model.Cities">
        <option value="">choose a city</option>
    </select>
    <span asp-validation-for="CityId" class="error"></span>
</p>
<p>
    <label asp-for="CategoryId">category</label>
    <select asp-for="CategoryId" asp-items="Model.Categories">
        <option value="">choose a category</option>
    </select>
    <span asp-validation-for="CategoryId" class="error"></span>
</p>
<p>
    <label asp-for="Neighborhood">neighborhood (optional)</label>
    <input asp-for="Neighborhood" />
    <span asp-validation-for="Neighborhood" class="error"></span>
</p>
<p>
    <label asp-for="ContactEmail">contact email</label>
    <input asp-for="ContactEmail" type="email" />
    <span asp-validation-for="ContactEmail" class="error"></span>
</p>
