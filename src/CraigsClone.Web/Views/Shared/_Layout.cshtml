<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CraigsClone</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <a class="brand" href="/">CraigsClone</a>
        @if (ViewData["CitySlug"] is string citySlug)
        {
            <a class="city" href="/@citySlug">@ViewData["CityName"]</a>
            <a class="post" href="/post?city=@citySlug">post</a>
        }
        else
        {
            <a class="post" href="/post">post</a>
        }
    </header>
    <main>
        @RenderBody()
    </main>
</body>
</html>
